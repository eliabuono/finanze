{
  "name": "finanze",
  "version": "1.0.0",
  "private": true,
  "description": "Conti, investimenti, entrate e uscite dagli estratti conto in PDF (Intesa Sanpaolo, Trade Republic, Satispay)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev && npx --yes http-server dist -p 8080 -c-1",
    "icone": "node icone.mjs",
    "check": "tsc -p tsconfig.json",
    "android": "node build.mjs && npx cap sync android && npx cap open android",
    "ios": "node build.mjs && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-time-format": "4.1.0",
    "jszip": "3.10.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "esbuild": "0.28.2",
    "sharp": "^0.34.0",
    "typescript": "6.0.3"
  }
}
